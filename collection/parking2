def determine_hazard_title(latest: Dict[str, Any]) -> str:
    if not latest or latest.get("severity") == "NORMAL":
        return "Environment is Safe"

    classes = [c.lower() for c in latest.get("yolo_classes", "").split(",") if c.strip()]
    description = latest.get("description", "").lower()
    keyword = str(latest.get("matched_keyword", "")).lower()

    has_fire = any("fire" in item for item in classes) or "fire" in description or "fire" in keyword
    has_smoke = any("smoke" in item for item in classes) or "smoke" in description or "smoke" in keyword

    if latest.get("fire_ratio", 0) > 0.010:
        has_fire = True
    if latest.get("smoke_ratio", 0) > 0.10:
        has_smoke = True

    if has_fire and has_smoke:
        return "Fire & Smoke Detected"
    elif has_fire:
        return "Fire Detected"
    elif has_smoke:
        return "Smoke Detected"
    else:
        return "Fire or Smoke Detected"


